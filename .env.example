# Set production values through Sites. Never commit actual credentials.
# Generate a unique random ADMIN_TOKEN for EACH new installation (32 random bytes).
# For an existing installation, preserve its current ADMIN_TOKEN.
ADMIN_TOKEN=
OPENAI_API_KEY=
# Maximum allowed cumulative AI spend for this installation, in USD.
# Blank defaults to 4.50. Invalid values stop AI. Range: 0 to 10000.
# Set a lower operational limit in the administrator's Shared/Settings tab.
AI_BUDGET_CAP=
